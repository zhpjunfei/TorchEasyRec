train_config {
  sparse_optimizer {
    adam_optimizer {
      lr: 0.001
    }
    cosine_annealing_learning_rate {
      T_max: 6300
      min_learning_rate: 0.0001
      warmup_learning_rate: 0.0
      warmup_size: 1000
    }
  }
  dense_optimizer {
    adam_optimizer {
      lr: 0.001
      beta1: 0.9
      beta2: 0.999
    }
    cosine_annealing_learning_rate {
      T_max: 6300
      min_learning_rate: 0.0001
      warmup_learning_rate: 0.0
      warmup_size: 1000
    }
    part_optimizers {
      adamw_optimizer {
        lr: 0.001
        weight_decay: 0.01
        beta1: 0.9
        beta2: 0.999
      }
      cosine_annealing_learning_rate {
        T_max: 6300
        min_learning_rate: 0.0001
        warmup_learning_rate: 0.0
        warmup_size: 1000
      }
      regex_pattern: "(.*)(epnet\\.gate|cdot\\.compress_mlp|task_towers\\..*tower_layers|task_towers\\..*gate_mlps)\\.(.*)\\.weight"
    }
    part_optimizers {
      adamw_optimizer {
        lr: 0.001
        weight_decay: 0.01
        beta1: 0.9
        beta2: 0.999
      }
      cosine_annealing_learning_rate {
        T_max: 6300
        min_learning_rate: 0.0001
        warmup_learning_rate: 0.0
        warmup_size: 1000
      }
      regex_pattern: "(.*)cdot\\.sub_compress_weight"
    }
    part_optimizers {
      adamw_optimizer {
        lr: 0.0005
        weight_decay: 0.05
        beta1: 0.9
        beta2: 0.999
      }
      cosine_annealing_learning_rate {
        T_max: 6300
        min_learning_rate: 0.0001
        warmup_learning_rate: 0.0
        warmup_size: 1000
      }
      regex_pattern: ".*task_towers.*cvr.*"
    }
  }
  num_epochs: 1
  save_checkpoints_steps: 500
  use_tensorboard: true
  save_checkpoints_epochs: 0
}
eval_config {
}
export_config {
}
data_config {
  batch_size: 4096
  dataset_type: OdpsDataset
  label_fields: "is_click"
  label_fields: "is_conversion"
  num_workers: 18
  fg_mode: FG_BUCKETIZE
  odps_data_compression: "ZSTD"
  sample_weight_fields: "search_weight"
}
feature_configs {
  id_feature {
    feature_name: "item_id"
    expression: "item:item_id"
    embedding_dim: 32
    hash_bucket_size: 3000000
  }
}
feature_configs {
  id_feature {
    feature_name: "mmb_id"
    expression: "user:mmb_id"
    embedding_dim: 32
    zch {
      zch_size: 2529348
      eviction_interval: 2
      lfu {}
      threshold_filtering_func: "lambda x: dynamic_threshold_filter(x, 3.0)"
    }
  }
}
