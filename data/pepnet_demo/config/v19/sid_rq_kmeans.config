# sid_rq_kmeans.config — SID 生成（RQKMeans）P1 草案 v2（2026-11-05）
# v2 变更：输入源定为 title_vector（128 维文本语义向量）
#   来源表：feature_mall_feed_rec_flow_item_title_embedding_string_v5_offline
#     列：item_id STRING / title_vector STRING（逗号分隔、每位 7 位小数，ARRAY<DOUBLE> 经 CONCAT_WS(',') 转存）
#     分区 dt/hh，LIFECYCLE 90；取数按 fs_write_time DESC 每 item_id 去重取最新（sample-v3-pipeline 口径）
#   读法依据（本仓库已跑通）：home_flow_2604_v10_title_vector.config 的
#     raw_feature { feature_name: "title_vector" expression: "item:title_vector" value_dim: 128 separator: "," }
#   —— STRING 向量列用 separator: "," 直接解析，无需 SQL 转 array。
# 运行约束（文档 §2.4）：RQKMeans 仅 CPU 单进程 → torchrun --nproc-per-node=1 + OMP_NUM_THREADS=$(nproc)
#   num_epochs: 1（on_train_end 一次性拟合）；save_checkpoints_*=0；优化器学习率仅框架形式配置。
# codebook 已定稿（2026-11-05）：输入池 N=80,164（dt=20261030 快照，dim=128 全量一致、无脏行）。
#   [256,256,256] 对该规模合理（估算表 [1024]³ 是百万级池的保守上限，80K 不需要）；
#   唯一回调判据：predict 后 unique_sid_ratio<70% 才扩层宽（如 [512,512,512] 或非均匀 [128,256,1024]）。
# 升级路径（换源时必须同步改 value_dim，两版禁混用）：
#   万物向量 qwen3-vl-embedding 融合向量 mix_embedding_vec → 2560（数组列，FG_DAG，去 separator）
#   tongyi-embedding-vision-plus 独立向量 → 1152
# 质量门槛（plan §4.4）：unique_sid_ratio>70% / 簇内 cate3-spu 纯度 / 覆盖率 95%+ / 离在线同码本
# 输出（文档 §2.5）：codes=array<int64> + --reserved_columns item_id 透传；
#   自动指标 mse / rel_loss / unique_sid_ratio → 落 item_sid_map(item_id, sid_l1, sid_l2, sid_l3, sid_path)

train_config {
    sparse_optimizer { adagrad_optimizer { lr: 0.001 } constant_learning_rate {} }
    dense_optimizer  { adam_optimizer   { lr: 0.00002 } constant_learning_rate {} }
    num_epochs: 1
    save_checkpoints_steps: 0
    save_checkpoints_epochs: 0
}

feature_configs {
    raw_feature {
        feature_name: "emb"
        expression: "item:title_vector"
        value_dim: 128
        separator: ","
    }
}

model_config {
    feature_groups { group_name: "deep" feature_names: "emb" group_type: DEEP }
    sid_rqkmeans {
        codebook: 256
        codebook: 256
        codebook: 256
        normalize_residuals: true
        faiss_kmeans_kwargs { niter: 20 seed: 42 verbose: true spherical: false }
    }
}
