    ,is_conversion                                                  BIGINT
)
PARTITIONED BY
(
    dt string
)
LIFECYCLE 90
;

-- ============================================================
-- 优化版样本提取逻辑 (v2)
-- ============================================================

-- Step 1: 所有曝光事件 (正+负候选)
-- 关键改动: GROUP BY 增加 request_id → 细化到每次曝光
WITH all_exposure AS (
    SELECT mmb_id, item_id, request_id, scene, page,
           day_h, week_day,
           MAX(IF(event = 'click', 1, 0)) AS is_click,
           MAX(IF(event = 'conversion', 1, 0)) AS is_conversion,
           MIN(event_unix_time) AS event_unix_time
    FROM home_flow_2604_dwd_log_zhekou_rec_user_bhv_info_preprocess_v1
    WHERE dt = '${bdp.system.bizdate}'
      AND event = 'exposure'
      AND request_id IS NOT NULL
    GROUP BY mmb_id, item_id, request_id, scene, page, day_h, week_day
),

-- Step 2: 标记正负
labeled AS (
    SELECT *,
           CASE WHEN is_click = 1 OR is_conversion = 1 THEN 1 ELSE 0 END AS label
    FROM all_exposure
),

-- Step 3: 用户活跃度统计 (替代 click_cnt 窗口)
user_stats AS (
    SELECT mmb_id,
           SUM(is_click) AS total_clicks,
           COUNT(*) AS total_exposures,
           AVG(is_click) AS ctr
    FROM labeled
    GROUP BY mmb_id
),

-- Step 4: 正样本 (全量)
positive AS (
    SELECT l.*, u.total_clicks
    FROM labeled l
    JOIN user_stats u ON l.mmb_id = u.mmb_id
    WHERE u.total_clicks < 100
      AND l.label = 1
),

-- Step 5: 负采样 (同用户同场景, 1:3)
negative AS (
    SELECT l.*, u.total_clicks
    FROM labeled l
    JOIN user_stats u ON l.mmb_id = u.mmb_id
    WHERE u.total_clicks < 100
      AND l.label = 0
      -- 1:3 负采样 — MOD(HASH(...), 4) = 0 采样 1/4
      AND MOD(ABS(HASH(CONCAT(l.mmb_id, l.item_id))), 4) = 0
),

-- Step 6: 合并正负样本
sampled AS (
    SELECT * FROM positive
    UNION ALL
    SELECT * FROM negative
)

-- Step 7: 输出
INSERT OVERWRITE TABLE home_flow_2604_ctrcvr_sorter_label_table_v1
PARTITION (dt = '${bdp.system.bizdate}')
SELECT event_unix_time, item_id, item_id AS __item_id__,
       scene, mmb_id, mmb_id AS __mmb_id__,
       request_id, page, day_h, week_day,
       is_click, is_conversion
FROM sampled;
