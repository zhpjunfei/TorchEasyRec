CREATE TABLE IF NOT EXISTS ads_log_zhekou_rec_item_basic_info(
	item_id STRING COMMENT '物料 id',
	 item_type STRING COMMENT '物料类型，对应 doc_type',
	 `status` BIGINT COMMENT '可推荐状态：0 不可推荐，1 可推荐',
	 cate STRING COMMENT 'cate -> cate_name_path，多级类目名称，级间用 $##$ 分隔（火山格式）',
	 cate_id_path STRING COMMENT '全类目ID路径，支持多级类目，用下划线连接',
	 content STRING COMMENT '正文内容（可为空字符串）',
	 copyright_end BIGINT COMMENT '内容失效时间，秒级时间戳（例：1622476800）',
	 copyright_start BIGINT COMMENT '内容生效时间，秒级时间戳',
	 create_time BIGINT COMMENT '文章创建时间，建议用秒级时间戳',
	 current_price DOUBLE COMMENT '物品现价',
	 keyword STRING COMMENT '关键词，多个用英文逗号分隔',
	 pub_time BIGINT COMMENT '内容发布时间戳（秒）',
	 tags STRING COMMENT '内容标签，多值用 $##$ 分隔，例如 "近期新闻$##$时政热点"',
	 title STRING COMMENT '内容标题',
	 update_time BIGINT COMMENT '内容信息更新时间戳（秒）',
	 pic_url STRING COMMENT '图片 url，多张用 $##$ 分隔，头图放前面',
	 related_goods_ids STRING COMMENT '相关商品 id，多个使用 $##$ 分隔',
	 brand STRING COMMENT '品牌',
	 rec_city_list STRING COMMENT '可推城市列表（多值建议 $##$ 分隔）',
	 core_entity STRING COMMENT '帖子商品主体词',
	 coupon STRING COMMENT '优惠券：满多少减多少，文本描述',
	 cps_rate BIGINT COMMENT '佣金率（整数，单位视业务而定）',
	 dianpufensi STRING COMMENT '店铺粉丝数（字符串以避免超大数字问题）',
	 dianpupingfen STRING COMMENT '店铺评分（字符串或小数文本）',
	 discount_intensity STRING COMMENT '优惠力度描述',
	 discount_type STRING COMMENT '优惠类型',
	 first_cate_id BIGINT COMMENT '一级类目 id（新）',
	 second_cate_id BIGINT COMMENT '二级类目 id（新）',
	 third_cate_id BIGINT COMMENT '三级类目 id（新）',
	 first_cate_name STRING COMMENT '一级类目名称（新）',
	 second_cate_name STRING COMMENT '二级类目名称（新）',
	 third_cate_name STRING COMMENT '三级类目名称（新）',
	 gender_score BIGINT COMMENT '性别分',
	 kaidianshichang STRING COMMENT '开店时长（文本）',
	 level STRING COMMENT '帖子等级，例如 s、ss、sss',
	 mall_channel STRING COMMENT '商城频道',
	 mjt_cost STRING COMMENT '慢津贴金额（文本）',
	 modifiers STRING COMMENT '帖子商品修饰词，多值建议用 $##$ 分隔（原为 array<string>）',
	 pinpaidengji STRING COMMENT '品牌等级',
	 price_tag STRING COMMENT '价格标签',
	 promotion_channel STRING COMMENT '促销频道',
	 publish_user STRING COMMENT '发布人',
	 shop_id STRING COMMENT '商品所属店铺 id',
	 site STRING COMMENT '商品来源类型，多值建议 $##$ 分隔（原为 array<string>）',
	 spu_id STRING COMMENT '商品的 spu id',
	 sqk_id STRING COMMENT '精选折扣 ID',
	 sr BIGINT COMMENT '佣金（sr）',
	 sub_title STRING COMMENT '物品描述（副标题）',
	 username STRING COMMENT '帖子推荐人',
	 xs BIGINT COMMENT 'gmv'
)
PARTITIONED BY (dt STRING COMMENT '日期分区') STORED AS aliorc
TBLPROPERTIES ('columnar.nested.type'='true',
	 'comment'='算法-折扣-物料/商品基础信息')
LIFECYCLE 365;
