CREATE TABLE IF NOT EXISTS ods_lh_log2_user_bhv_df(
	area STRING COMMENT '地区',
	 bhv_time STRING COMMENT '行为时间',
	 bhv_type STRING COMMENT '行为类型',
	 brand_id STRING COMMENT '品牌id',
	 cate STRING,
	 cate_cnt STRING,
	 category_id STRING COMMENT '分类id',
	 city STRING COMMENT '城市',
	 client_version STRING COMMENT '客户端版本',
	 country STRING COMMENT '国家',
	 device_model STRING COMMENT '机型',
	 district STRING COMMENT '行政区',
	 doc_id STRING COMMENT 'itemid',
	 goods_name STRING COMMENT '商品名',
	 network STRING COMMENT '网络',
	 os STRING COMMENT '操作系统',
	 os_version STRING COMMENT '操作系统版本',
	 parent_doc_id STRING COMMENT '父itemid',
	 platform STRING COMMENT '平台',
	 province STRING COMMENT '省',
	 query STRING COMMENT '搜索',
	 request_id STRING COMMENT '请求id',
	 scm STRING COMMENT 'scm',
	 spm STRING COMMENT 'spm',
	 trace_id STRING COMMENT 'traceid',
	 trans_data STRING,
	 user_id STRING COMMENT '用户id',
	 other_data STRING COMMENT '其他数据',
	 topic STRING COMMENT '主题',
	 trans_data_plain_text STRING,
	 meta_json STRING COMMENT '元数据信息',
	 first_cate_id BIGINT COMMENT '一级类目id',
	 second_cate_id BIGINT COMMENT '二级类目id',
	 third_cate_id BIGINT COMMENT '三级类目id',
	 mmb_trans_data STRING
)
PARTITIONED BY (dt STRING) STORED AS aliorc
TBLPROPERTIES ('comment'='折扣用户行为日志')
LIFECYCLE 740;
